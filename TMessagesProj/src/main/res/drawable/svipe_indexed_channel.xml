<!-- Badge drawn before the name of any channel Svipe has indexed. The Reels tab's own mark — a play
     triangle in a ring — so the badge says the same thing the tab does: this channel is inside the
     app. Replaces the ♪ note, which only ever meant "we have this channel's music".
     White fill; tint at the call site. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The ring, drawn as an even-odd donut so it stays a ring under any tint. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2A10,10 0 1,0 12,22A10,10 0 1,0 12,2zM12,4a8,8 0 1,1 0,16a8,8 0 1,1 0,-16z" />
    <!-- The play triangle, optically centred (a centred triangle reads as left-heavy). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,8.2l6,3.8 -6,3.8z" />
</vector>
