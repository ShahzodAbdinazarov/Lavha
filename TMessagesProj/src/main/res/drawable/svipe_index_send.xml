<!-- The ⋮ action "Send for indexing". It is the indexed-channel badge with a plus on it, so the icon
     shows what the action produces: the mark this channel does not have yet. The note it replaces
     said "music", which was never what the action did once one request began feeding every pipe.

     The ring is an arc with a gap rather than a full circle — the plus sits IN the gap, so the two
     glyphs never collide and the plus stays readable at 24dp. White; tinted at the call site. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The ring: 290° of arc, open towards the bottom-right corner where the plus goes. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:fillColor="#00000000"
        android:pathData="M11.92,18.58A8.2,8.2 0 1,1 18.58,11.92" />
    <!-- The play triangle, optically centred in the ring (a centred triangle reads as left-heavy). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.4,6.9l6.2,3.6 -6.2,3.6z" />
    <!-- The plus, in the corner the ring left open. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.8,15.6h1.8v2.3h2.3v1.8h-2.3v2.3h-1.8v-2.3h-2.3v-1.8h2.3z" />
</vector>
