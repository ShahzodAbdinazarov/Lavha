    <!-- Svipe profil rasmlari arxivi -->
    <string name="SvipeAvatarArchive">Profil rasmlari arxivi</string>
    <string name="SvipeAvatarVisibilityHeader">Arxivdagi rasmlarimni kim ko\'ra oladi</string>
    <string name="SvipeAvatarVisibilityEveryone">Hamma</string>
    <string name="SvipeAvatarVisibilityContacts">Kontaktlarim</string>
    <string name="SvipeAvatarContactsConfirm">Kim kontaktingiz ekanini tekshirish uchun Svipe kontaktlaringizning Telegram ID larini o\'z serverida saqlaydi. Ular faqat shu tekshiruv uchun ishlatiladi — hech qachon uchinchi tomonga berilmaydi va boshqa hech qanday maqsadda ishlatilmaydi — hamda boshqa variantni tanlashingiz bilan o\'chiriladi.</string>
    <string name="SvipeAvatarVisibilityNobody">Hech kim</string>
    <string name="SvipeAvatarVisibilityOff">Rasmlarimni arxivlamang</string>
    <string name="SvipeAvatarVisibilityInfo">Arxivdagi rasmlaringiz faqat Telegram allaqachon joriy profil rasmingizni ko\'rishga ruxsat bergan odamlarga ko\'rinadi. Bu sozlama uni faqat toraytiradi, hech qachon kengaytirmaydi.</string>
    <string name="SvipeAvatarOptOut">Arxivlanmasin</string>
    <string name="SvipeAvatarOptOutConfirm">Rasmlaringiz endi arxivlanmaydi va arxivdagilari o\'chiriladi.</string>
    <string name="SvipeAvatarSyncHeader">Sinxronlash</string>
    <string name="SvipeAvatarSyncEnabled">Saqlagan rasmlarimni ulashish</string>
    <string name="SvipeAvatarSyncWifiOnly">Faqat Wi-Fi orqali yuklash</string>
    <string name="SvipeAvatarSyncInfo">Kimdir siz allaqachon ko\'rgan profil rasmini o\'chirsa, bu qurilma o\'z nusxasini ulashishi mumkin — shunda o\'sha odamni ko\'rishga ruxsati bor boshqalar ham uni ocha oladi. O\'chirsangiz, rasmlar shu qurilmada qoladi.</string>
    <string name="SvipeAvatarDeleteArchive">Arxivdagi rasmlarimni o\'chirish</string>
    <string name="SvipeAvatarDeleteArchiveInfo">Arxivdan sizga tegishli barcha rasmni olib tashlaydi. Yuqorida "Rasmlarimni arxivlamang" ni tanlamasangiz, yangilari yana arxivlanadi.</string>
    <string name="SvipeAvatarDeleteArchiveConfirm">Sizga tegishli barcha arxiv rasmi o\'chirilsinmi?</string>
    <string name="SvipeAvatarArchiveDeleted">Arxivdagi rasmlar o\'chirildi</string>
    <string name="SvipeAvatarSettingsFailed">Serverga ulanib bo\'lmadi. Qayta urinib ko\'ring.</string>
    <string name="SvipeIntroStart">Svayp qilishni boshlash</string>

    <!-- Svipe terms & privacy disclosure (mandatory, shown once) -->
    <string name="SvipeTermsTitle">Svipe — Shartlar va maxfiylik</string>
    <string name="SvipeTermsMessage">Svipe — Telegram asosidagi mustaqil ilova. Agar shaxsiy suhbatdagi ikkala odam ham Svipe ishlatsa va ikkalasi ham yoqsa, Svipe o\'sha suhbatning o\'chirilgan va tahrirlangan xabarlarini akkauntingizda saqlab, ikkovingiz bir xil tarixni ko\'rasiz. U standart holatda o\'chiq, faqat o\'sha ikki kishiga tegishli, hech qachon guruh yoki Maxfiy chatlarga emas, va uni istalgan payt Sozlamalarda boshqarasiz. Nimalarni to\'playmiz, nega va qanday himoyalanadi — **Maxfiylik siyosati**da o\'qing.</string>
    <string name="SvipeTermsAccept">Qabul qilish va davom etish</string>

    <!-- In-app update: Svipe-branded title (the native AppUpdate key resolves to "Update Telegram"
         via Telegram's cloud langpack, so the title uses this custom key the langpack cannot override).
         The other update strings keep their native keys and are localized by the cloud langpack. -->
    <string name="SvipeUpdateTitle">Svipe’ni yangilash</string>

    <!-- Fon rejimidagi joylashuv uchun ochiq ogohlantirish: Svipe brendi bilan, maxsus kalit ostida —
         native PermissionBackgroundLocation kalitini Telegram’ning bulutli til paketi qayta yozadi. -->
    <string name="SvipePermissionBackgroundLocation">Bu chatda jonli joylashuvingizni ulashish uchun Svipe’ga joylashuvingizdan doimiy, ilova fonda ishlayotganda ham, foydalanish ruxsati kerak.\n\nJoylashuvingizdan faqat siz tanlagan muddat davomida foydalanamiz va uni istalgan vaqtda to‘xtatishingiz mumkin. Joylashuvingizni bu chatda ulashishdan boshqa hech qanday maqsadda ishlatmaymiz.</string>

    <!-- Kontaktlar uchun ochiq ogohlantirish. Maxsus kalit, chunki asl matnda “Telegram” ikki xil
         ma’noda keladi: ruxsat so‘rayotgan ilova (biz) va kontaktlar sinxronlanadigan serverlar
         (haqiqatan Telegram’niki). Oddiy almashtirish ikkinchisini yolg‘onga aylantirardi. -->
    <string name="SvipeContactsPermissionAlert">**Svipe**’ga kontaktlaringizdan foydalanish ruxsati kerak — shunda do‘stlaringiz bilan barcha qurilmalaringizda bog‘lana olasiz. Kontaktlaringiz Telegram’ning kuchli shifrlangan bulut serverlari bilan doimiy sinxronlanib turadi.</string>

