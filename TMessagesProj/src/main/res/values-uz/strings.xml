    <string name="SvipeVideoBackgroundPlayInfo">Ilovadan chiqqaningizda ovoz davom etsin</string>
    <string name="SvipeNumberHistory">Raqamlar tarixi</string>
    <string name="SvipeNumberHistoryInfo">Faqat shu qurilmada, shu versiya o\'rnatilgan kundan boshlab va faqat Telegram ko\'rsatgan raqamlar uchun yoziladi. Hech qayerga yuborilmaydi.</string>
