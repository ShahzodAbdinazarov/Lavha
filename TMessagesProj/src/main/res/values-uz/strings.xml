    <!-- Svipe message sync (P2P deleted/edited archive) -->
    <string name="SvipeMsgSyncTitle">O\'chirilgan xabar sinxroni</string>
    <string name="SvipeMsgSyncModeHeader">O\'chirilgan va tahrirlangan xabarlarni sinxronlash</string>
    <string name="SvipeMsgSyncWithPartner">Suhbatdosh bilan</string>
    <string name="SvipeMsgSyncSelfOnly">Faqat mening qurilmalarim</string>
    <string name="SvipeMsgSyncOff">Sinxronlanmasin</string>
    <string name="SvipeMsgSyncModeInfo">\"Suhbatdosh bilan\" — shaxsiy suhbatning o\'chirilgan va tahrirlangan xabarlarini ikkovingiz uchun saqlaydi, faqat ikkalangiz ham yoqsangiz. \"Faqat mening qurilmalarim\" — faqat o\'zingiz yuborgan xabarlarni o\'zingiz uchun zaxiralaydi. Alohida suhbatni o\'sha suhbat ichidan o\'chirib qo\'yishingiz mumkin. Guruh, kanal yoki Maxfiy chatlarga hech qachon qo\'llanmaydi.</string>
    <string name="SvipeMsgSyncOffConfirm">Sinxronni o\'chirsangiz, suhbatdoshingizning o\'chirgan xabarlari ham sizga kelmaydi — xuddi \"oxirgi ko\'rilgan\"ni yashirgandek. O\'chirilsinmi?</string>
    <string name="SvipeMsgSyncDelete">Serverdan hammasini o\'chirish</string>
    <string name="SvipeMsgSyncDeleteInfo">Siz sinxronlagan barcha xabarni o\'chiradi. Qurilmangizda qoladi.</string>
    <string name="SvipeMsgSyncDeleteConfirm">Serverga sinxronlagan barcha xabaringiz o\'chirilsinmi?</string>
    <string name="SvipeMsgSyncArchiveDeleted">Sinxronlangan xabarlar o\'chirildi</string>
    <string name="SvipeMsgSyncFailed">Serverga ulanib bo\'lmadi. Qayta urinib ko\'ring.</string>
    <string name="SvipeMsgSyncBanner">Suhbatdoshingiz Svipe ishlatadi. Shu suhbatning o\'chirilgan xabarlarini sinxronlab, ikkovingiz bir xil tarixni saqlaysizmi?</string>
    <string name="SvipeMsgSyncPromptTitle">O\'chirilgan va tahrirlangan xabarlar sinxronlansinmi?</string>
    <string name="SvipeMsgSyncPromptMessage">**Svipe** o\'chirgan yoki tahrirlagan xabarlaringizni saqlab, yo\'qotmasligingizga yordam beradi. **Ruxsat** — suhbatdosh bilan (faqat ikkalangiz ham yoqsangiz) va o\'z qurilmalaringiz aro sinxronlash. **O\'zimga** — faqat o\'z xabarlaringizni zaxiralash. **Rad etish** — sinxronlamaslik. Istalgan payt Sozlamalarda o\'zgartirasiz.</string>
    <string name="SvipeMsgSyncSnackbar">O\'chirilgan va tahrirlangan xabarlar sinxronlansinmi?</string>
    <string name="SvipeMsgSyncAllow">Ruxsat</string>
    <string name="SvipeMsgSyncForMe">O\'zimga</string>
    <string name="SvipeMsgSyncGranted">Sinxron yoqildi — Sozlamalardan o\'zgartirasiz</string>
    <string name="SvipeMsgSyncRemind">Bir oy so\'ralmasin</string>
    <string name="SvipeMsgSyncRemindInfo">Yoqsangiz, bir oygacha sinxronlash umuman so\'ralmaydi.</string>

    <!-- In-app update: Svipe-branded title (the native AppUpdate key resolves to "Update Telegram"
         via Telegram's cloud langpack, so the title uses this custom key the langpack cannot override).
         The other update strings keep their native keys and are localized by the cloud langpack. -->
    <string name="SvipeUpdateTitle">Svipe’ni yangilash</string>

    <!-- Fon rejimidagi joylashuv uchun ochiq ogohlantirish: Svipe brendi bilan, maxsus kalit ostida —
         native PermissionBackgroundLocation kalitini Telegram’ning bulutli til paketi qayta yozadi. -->
    <string name="SvipePermissionBackgroundLocation">Bu chatda jonli joylashuvingizni ulashish uchun Svipe’ga joylashuvingizdan doimiy, ilova fonda ishlayotganda ham, foydalanish ruxsati kerak.\n\nJoylashuvingizdan faqat siz tanlagan muddat davomida foydalanamiz va uni istalgan vaqtda to‘xtatishingiz mumkin. Joylashuvingizni bu chatda ulashishdan boshqa hech qanday maqsadda ishlatmaymiz.</string>

    <!-- Kontaktlar uchun ochiq ogohlantirish. Maxsus kalit, chunki asl matnda “Telegram” ikki xil
         ma’noda keladi: ruxsat so‘rayotgan ilova (biz) va kontaktlar sinxronlanadigan serverlar
         (haqiqatan Telegram’niki). Oddiy almashtirish ikkinchisini yolg‘onga aylantirardi. -->
    <string name="SvipeContactsPermissionAlert">**Svipe**’ga kontaktlaringizdan foydalanish ruxsati kerak — shunda do‘stlaringiz bilan barcha qurilmalaringizda bog‘lana olasiz. Kontaktlaringiz Telegram’ning kuchli shifrlangan bulut serverlari bilan doimiy sinxronlanib turadi.</string>

